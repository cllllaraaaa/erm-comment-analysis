# ---------------------------------------------------------------
# Secrets — never commit keys
# ---------------------------------------------------------------
.env
.env.*
*.key
secrets*
service-account*.json

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------
# Large / derived data
#
# The raw docket snapshot and the intermediate CSVs the notebooks
# produce are not committed (see data/README.md). Everything under
# data/ is ignored by default, then the small files the repository
# genuinely needs are re-included below.
#
# IMPORTANT: the negations must come after the ignore rules, or the
# committed data files silently disappear from the repository.
# ---------------------------------------------------------------
**/data/*.csv
**/data/*.xlsx
**/data/*.numbers
*.parquet
*.pkl

# ...but keep these:
!**/data/label_done_150.csv
!**/data/sample_labelled_comments.csv
!**/data/topic_pack.json
!**/data/README.md

# Compressed data is small enough to commit — allow it explicitly
!**/data/*.csv.gz

# Notebook working artefacts
**/attachment_cache_fixed/
**/attachment_cache/
*.log

# ---------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
